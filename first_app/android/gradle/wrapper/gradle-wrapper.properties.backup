distributionBase=GRADLE_USER_HOME
distributionPath=wrapper/dists
zipStoreBase=GRADLE_USER_HOME
zipStorePath=wrapper/dists
## By default the wrapper downloads from services.gradle.org. If your network or
## antivirus/firewall interrupts the download, you can manually download the
## Gradle distribution zip and point the wrapper to a local file. Example:
## Download to: C:\Users\hamay\Downloads\gradle-9.1.0-all.zip
## Then uncomment the file URL below and comment out the https URL.
distributionUrl=file:///C:/Users/hamay/Downloads/gradle-9.1.0-all.zip
## If you want to revert to downloading from the network, replace the line above
## with:
## distributionUrl=https\://services.gradle.org/distributions/gradle-9.1.0-all.zip